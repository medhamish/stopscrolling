{
  "manifest_version": 3,
  "name": "Stop Scrolling",
  "version": "1.0.0",
  "description": "A lightweight website blocker that helps you stay focused. Block Instagram, YouTube, Reddit and any site you choose.",
  "minimum_chrome_version": "102",

  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Stop Scrolling",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
